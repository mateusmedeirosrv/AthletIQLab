{
  "expo": {
    "name": "AthletiQLab",
    "slug": "athletiqlab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "athletiqlab",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.athletiqlab.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.athletiqlab.app"
    },
    "plugins": ["expo-router", "react-native-reanimated", "expo-video", "./plugins/withWatchApp"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
